# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/

# LaTeX build artefacts (in case the manuscript is built here later)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# ...but the per-run sampler logs are release data, not build artefacts:
# build_paper_tables.py parses "Log Evidence:" out of them for every lnZ in
# Tables 1, 5 and 6, so they must survive the *.log rule above.
!results/test_suite/**/sampler.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Virtual envs
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Bulk data. Git carries the code, the per-run provenance and the derived
# summaries; the heavy data is fetched with `bash fetch_data.sh`.
# ---------------------------------------------------------------------------

# The nested-sampling chains: 58 files, 3.7 GB, one of them 1.2 GB. That last
# one cannot go in a GitHub repository at all (100 MB per-file hard limit), so
# rather than publish an arbitrary subset here and the remainder elsewhere, the
# whole set lives in the Zenodo deposit and none of it is committed.
#   get them:    bash fetch_data.sh chains
#   check them:  bash fetch_data.sh verify   (against results/CHAIN_MANIFEST.csv)
#   rebuild the bundle: bash make_chain_bundle.sh
# Everything else under results/ -- sampler logs, config.json, run_catalog.csv,
# the derived summary CSVs, the tables and the figure PDFs -- IS committed.
results/test_suite/*/samples.csv
results/test_suite/*/prior_samples.csv
results/gwtc1_phasemarg/*PhaseMarg*.csv
results/scaling_study/*PhaseMarg*.csv

# Chain bundles built by make_chain_bundle.sh for upload.
gw170817-chains-*.tar.gz
gw170817-chains-*.sha256

# Archives staged by fetch_data.sh before it unpacks them.
.cache/

# LVK data we do not redistribute. fetch_data.sh puts the strain and PSD
# inputs under data/; they are byte-identical (sha256) to the ones that
# produced the chains. The GWTC-2.1 GW150914 PE release is 287 MB and is
# LVK's to distribute.
data/
results/**/IGWN-GWTC2p1-v2-*.h5
